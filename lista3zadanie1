# PODPUNKT A

def a(n):
    if n % 2 == 0:
        return n
    return -n

# Złożność czasowa to O(1). Złożność pamięciowa to O(1).

# PODPUNKT B

def b(n):
    suma = 0
    for i in range (1, n + 1): # Nie można dzielić przez 0, dlatego zaczynamy od i = 1.
        if i % 2 == 0:
            znak = 1
        else:
            znak = -1
        suma += znak / i
    return suma

# Złożność czasowa to O(n). Złożność pamięciowa to O(1).

# PODPUNKT C

def c(n, x):
    suma = 0
    potega = 1
    for i in range (1, n +1):
        potega = potega * x
        skladnik = i * potega
        suma += skladnik
    return suma

# Złożność czasowa to O(n). Złożność pamięciowa to O(1).
