def fTrec(n, m):
    if m == 0:
        return n
    if n == 0:
        return m
    return fTrec(n - 1, m) + 2 * fTrec(n, m - 1)

# [Drzewo wywołań dla fTrec(3, 4) trzeba narysować.] T(3, 4) = 486.

def fTiter(n, m):
    t = list(range(m + 1)) # Dla m = 4 dostajemy [0, 1, 2, 3, 4]. To jest dokładnie wiersz 0.
    for i in range(1, n + 1): # Pętla po numerach wierszy 1, 2, ..., n. Wiersz 0 mamy już w liście, więc zaczynamy od 1.
        t[0] = i # Ustawia wartość w kolumnnie 0 na i dla aktualnego wiersza (bo T(i,0) = i).
        for j in range(1, m + 1): # Pętla po numerach kolumn 1, 2, ..., m. Kolumnę 0 mamy już w dzięki t[0] = i, więc zaczynamy od 1.
            t[j] = t[j] + 2 * t[j - 1]
    return t[m]
